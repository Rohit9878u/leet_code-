class Solution {
public:
    vector<int> applyOperations(vector<int>& nums) {

        int n=nums.size();

        for(int i=0; i<n-1; i++){

            if(nums[i] == nums[i+1]){
                nums[i]= nums[i]* 2;
                nums[i+1]=0;

        }
        }

        int first = 0;

        for(int sec = 0; sec < n; sec++) {
            if(nums[sec] != 0) {
                swap(nums[first], nums[sec]);
                first++;
            }
        }
        
         return nums;

        






    
        
    }

};
